namespace club.subjugated.fb.event;

table CommonMetadata {
    lock_session: string;
    contract_serial_number: ushort;
    serial_number: ushort;
    counter: ushort;
    event_id: string;
    correlation_id: string;
}

enum EventType : byte { Undefined = 0, AcceptContract, LocalLock, LocalUnlock, Lock, Unlock, ReleaseContract, EmergencyUnlock }

table Event {
  metadata: CommonMetadata;
  event_type: EventType;
}

table SignedEvent {
  signature: [ubyte];
  payload: Event;
}

root_type SignedEvent;