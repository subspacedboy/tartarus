namespace club.subjugated.fb.event;

table CommonMetadata {
    lock_session: string;
    contract_serial_number: ushort;
    serial_number: ushort;
    counter: ushort;
    event_id: string;
    correlation_id: string;
}

table AcceptContract {}
table LocalLock {}
table LocalUnlock {}
table Lock {}
table Unlock {}
table ReleaseContract {}
table EmergencyUnlock {}

table StartedUpdate {
    public_key: [ubyte];
    started_with_local_contract: bool;
    is_locked: bool;
}

table PeriodicUpdate {
    is_locked: bool;
    emergency_unlocked: bool = false;
    device_uptime: ulong;
}

union EventType {
    AcceptContract,
    LocalLock,
    LocalUnlock,
    Lock,
    Unlock,
    ReleaseContract,
    EmergencyUnlock,
    StartedUpdate,
    PeriodicUpdate
}

table Event {
  metadata: CommonMetadata;
  event: EventType;
}

table SignedEvent {
  signature: [ubyte];
  payload: Event;
}

root_type SignedEvent;